# Copy file này thành ".env" rồi điền thông tin.

# ===== 1. VIẾT KỊCH BẢN =====
# openai  = gọi qua 9router (hoặc bất kỳ API kiểu OpenAI nào)
# gemini  = gọi thẳng Gemini bằng GEMINI_API_KEY
# manual  = chương trình tạo sẵn prompt, bạn dán vào claude.ai / ChatGPT (dùng gói Pro/Plus, miễn phí API)
SCRIPT_PROVIDER=openai

# Địa chỉ và key của 9router (xem trong bảng điều khiển 9router)
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=
# Tên model đúng như 9router hiển thị
SCRIPT_MODEL=gemini-2.5-flash

# ===== 2. GEMINI (ảnh, giọng đọc, video Veo) =====
# Key lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=gemini-2.5-flash

# ===== 3. VẼ ẢNH =====
# gemini       = đẹp, nhân vật giống nhau giữa các cảnh (khuyên dùng)
# openai       = /images/generations qua OPENAI_BASE_URL
# pollinations = miễn phí, không cần key, nhân vật kém đồng nhất hơn
# placeholder  = ảnh giả để chạy thử
IMAGE_PROVIDER=gemini
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_IMAGE_MODEL=gpt-image-1

# ===== 4. GIỌNG ĐỌC =====
# edge   = miễn phí, giọng Việt tự nhiên (vi-VN-HoaiMyNeural: nữ, vi-VN-NamMinhNeural: nam)
# gemini = giọng Gemini TTS, biểu cảm hơn, dùng GEMINI_API_KEY
TTS_PROVIDER=edge
EDGE_VOICE=vi-VN-HoaiMyNeural
EDGE_RATE=-10%
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# ===== 5. VIDEO AI (chỉ dùng khi chạy --mode ai) =====
VEO_MODEL=veo-3.0-fast-generate-001

# ===== 6. DỰNG PHIM =====
SUBTITLE_FONT=Arial
# Giảm xuống 1.5 nếu máy yếu, dựng chậm
KENBURNS_SCALE=2
